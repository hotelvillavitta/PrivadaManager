generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COLONO
  ADMIN
}

enum NewsCategory {
  IMPORTANTE
  REGLAMENTO
  MANTENIMIENTO
  AVISO
  COMUNIDAD
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum FeeStatus {
  PAGADO
  ADEUDO
  PENDIENTE
}

enum FineStatus {
  PENDIENTE
  PAGADO
  ANULADA
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role     @default(COLONO)
  houseNumber  String?
  accessCode   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  newsPosts     NewsPost[]
  reactions     NewsReaction[]
  newsReads     NewsRead[]
  reservations  Reservation[]
  notifications Notification[]
  issuedFines   Fine[]          @relation("FineIssuedBy")
}

model NewsPost {
  id           String       @id @default(cuid())
  title        String
  body         String
  category     NewsCategory
  hasDocument  Boolean      @default(false)
  documentUrl  String?
  documentName String?
  publishedAt  DateTime     @default(now())
  authorId     String?
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  reactions     NewsReaction[]
  reads         NewsRead[]
  notifications Notification[]
}

model NewsReaction {
  id        String   @id @default(cuid())
  emoji     String
  newsId    String
  userId    String
  createdAt DateTime @default(now())

  news NewsPost @relation(fields: [newsId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newsId, userId, emoji])
}

model NewsRead {
  id     String   @id @default(cuid())
  newsId String
  userId String
  readAt DateTime @default(now())

  news NewsPost @relation(fields: [newsId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newsId, userId])
}

model Provider {
  id        String   @id @default(cuid())
  name      String
  role      String
  phone     String
  email     String?
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reservation {
  id          String            @id @default(cuid())
  date        String
  eventName   String
  guests      Int
  notes            String?
  rejectionReason String?
  status           ReservationStatus @default(PENDING)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  notifications Notification[]

  @@index([date])
}

model MonthlyFee {
  id             String    @id @default(cuid())
  houseNumber    String
  year           Int
  month          Int
  concept        String    @default("MANTENIMIENTO")
  amount         Float     @default(200)
  status         FeeStatus @default(PENDIENTE)
  paidAt         DateTime?
  financeEntryId String?   @unique
  financeEntry   FinanceEntry? @relation(fields: [financeEntryId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([houseNumber, year, month, concept])
}

/// Cargo independiente por cada uso de palapa. No es una cuota mensual:
/// una casa puede registrar varios pagos durante el mismo mes.
model PalapaPayment {
  id             String   @id @default(cuid())
  houseNumber    String
  amount         Float    @default(200)
  paidAt         DateTime @default(now())
  financeEntryId String?  @unique
  financeEntry   FinanceEntry? @relation(fields: [financeEntryId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([houseNumber, paidAt])
}

/// Multa o sanción por falta al reglamento interno.
/// El monto se suma a la cuota de mantenimiento del periodo indicado
/// (mes en curso si estamos en los primeros 10 días; si no, el mes siguiente).
model Fine {
  id                 String     @id @default(cuid())
  houseNumber        String
  category           String
  cause              String
  causeId            String?
  regulationArticle  String
  regulationExcerpt  String
  amount             Float
  status             FineStatus @default(PENDIENTE)
  notes              String?
  /// Periodo de cuota de mantenimiento al que se suma esta multa.
  billingYear        Int
  billingMonth       Int
  issuedAt           DateTime   @default(now())
  paidAt             DateTime?
  issuedById         String?
  issuedBy           User?      @relation("FineIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  financeEntryId     String?    @unique
  financeEntry       FinanceEntry? @relation(fields: [financeEntryId], references: [id], onDelete: SetNull)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  notifications      Notification[]

  @@index([houseNumber, status])
  @@index([houseNumber, billingYear, billingMonth, status])
  @@index([status, issuedAt])
}

model FinanceEntry {
  id          String   @id @default(cuid())
  type        String
  category    String
  description String
  amount      Float
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  monthlyFee    MonthlyFee?
  palapaPayment PalapaPayment?
  fine          Fine?
}

model Notification {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  body           String
  read           Boolean  @default(false)
  newsId         String?
  news           NewsPost? @relation(fields: [newsId], references: [id], onDelete: SetNull)
  reservationId  String?
  reservation    Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  fineId         String?
  fine           Fine?    @relation(fields: [fineId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
}

model PrivadaSettings {
  id      Int    @id @default(1)
  name    String
  address String
  phone   String
  email   String
  tagline String
}
