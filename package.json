{
  "name": "grenache-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:import": "tsx prisma/import-grenache.ts",
    "db:import:apply": "tsx prisma/import-grenache.ts --apply",
    "db:import:fees": "tsx prisma/import-grenache.ts --apply --fees-only"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@swc/helpers": "^0.5.23",
    "@types/bcryptjs": "^2.4.6",
    "@vercel/blob": "^2.7.0",
    "bcryptjs": "^3.0.3",
    "heic2any": "^0.0.4",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.19.0",
    "server-only": "^0.0.1",
    "tsx": "^4.23.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "xlsx": "^0.18.5"
  }
}
